                  "maxLength": 120
                },
                "properties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
