    {
      "name": "get_collection_products",
      "description": "List the products in one Melorra collection, 20 per page, using the season code and collection slug from list_collections.",
      "kind": "imperative",
      "inputSchema": {
        "type": "object",
        "properties": {
          "season": {
            "type": "string",
            "pattern": "^[A-Za-z][0-9]{2}$",
            "description": "Season code, e.g. W26."
          },
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9&-]+$",
            "description": "Collection slug from list_collections, e.g. belt-charms."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 1
          }
        },
        "required": [
