  "tools": [
    {
      "name": "get_agency",
      "description": "Use to retrieve only the public profile and contact details of a specific CasaBitare real-estate agency already identified by its agency id.",
      "kind": "imperative",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agency_id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^A00[1-9][0-9]*$"
              }
            ],
            "description": "Agency identifier, such as A00213; a numeric WordPress author id is also accepted."
          }
        },
        "required": [
          "agency_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_property",
      "description": "Use to retrieve the complete canonical public record for one property already identified by search_properties. Do not use for discovery or lists.",
      "kind": "imperative",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric CasaBitare property id returned by search_properties."
          }
        },
        "required": [
          "property_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_locations",
      "description": "Use to find valid CasaBitare geographic places, resolve partial or ambiguous names case-insensitively, and obtain stable identifiers before searching properties.",
      "kind": "imperative",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Exact or partial Italian place name, for example tori."
          },
          "type": {
            "type": "string",
            "enum": [
              "region",
              "province",
              "city",
              "district"
            ],
            "description": "Optional geographic level; district covers localities and neighbourhoods."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
