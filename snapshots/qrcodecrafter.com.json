                "type": "string",
                "maxLength": 220000,
                "description": "CSV rows such as filename,value or value,filename."
              }
            ],
            "description": "Rows to include in the ZIP archive. Use up to 50 rows per request."
          },
          "format": {
            "type": "string",
            "enum": [
              "svg",
              "png",
              "jpg",
              "webp",
              "pdf",
              "eps"
