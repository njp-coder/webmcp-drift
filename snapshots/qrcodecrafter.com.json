    {
      "name": "manage_dynamic_qr",
      "description": "Read, update, pause, resume, rotate, or permanently delete a dynamic QR redirect using its private capability. Changes fetch the current ETag first.",
      "kind": "imperative",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "read",
              "update",
              "pause",
              "resume",
              "rotate",
              "delete"
            ],
            "default": "read",
            "description": "Read, update, pause, resume, rotate, or permanently delete the dynamic QR redirect."
          },
          "slug": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$",
            "description": "Public 22-character identifier from the redirect or management URL."
          },
          "managementToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Private 43-character bearer capability. Never include it in public QR artwork."
          },
          "destination": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048,
            "description": "Replacement public HTTPS destination, required when updating the URL."
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "description": "Optional replacement private label for an update action."
          }
        },
        "required": [
          "action",
          "slug",
          "managementToken"
        ],
        "additionalProperties": false
      }
    },
